# Supabase credentials template
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Upstash Redis (Distributed Rate Limiting & Shared Cache for /api/discover on Vercel)
# Leave unset during local development to automatically use the bounded in-memory fallback.
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token-here

# Optional outage mode in production if Redis becomes unreachable:
# - degraded-memory (default): active per-instance emergency throttling (never disables protection)
# - fail-closed: returns HTTP 503 Service Unavailable while Redis is unreachable
# TERRATWIN_REDIS_FAIL_MODE=degraded-memory
